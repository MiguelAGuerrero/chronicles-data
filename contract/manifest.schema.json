{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "manifest.json as scripts/manifest.mjs writes it. Generated by `npm run contract`.",
  "contractVersion": 9,
  "type": "object",
  "required": [
    "schema",
    "regions"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "current",
          "previous"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+$"
          },
          "current": {
            "$ref": "#/$defs/file"
          },
          "previous": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/file"
            },
            "description": "Older versions still served, newest first"
          },
          "stores": {
            "type": "object",
            "required": [
              "current",
              "previous"
            ],
            "description": "ST7: the region's stores pack, beside `current`; absent in older manifests and where there is none",
            "properties": {
              "current": {
                "$ref": "#/$defs/storesFile"
              },
              "previous": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/storesFile"
                },
                "description": "Older versions still served, newest first"
              }
            }
          },
          "fixtures": {
            "type": "object",
            "required": [
              "current",
              "previous"
            ],
            "description": "FX8: the region's fixtures pack, beside `current` and `stores`; absent in older manifests and where there is none",
            "properties": {
              "current": {
                "$ref": "#/$defs/fixturesFile"
              },
              "previous": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/fixturesFile"
                },
                "description": "Older versions still served, newest first"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "storesFile": {
      "allOf": [
        {
          "$ref": "#/$defs/file"
        }
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^stores-[a-z0-9]+-\\d{8}(?:\\.\\d+)?\\.pmtiles$"
        }
      }
    },
    "fixturesFile": {
      "allOf": [
        {
          "$ref": "#/$defs/file"
        }
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^fixtures-[a-z0-9]+-\\d{8}(?:\\.\\d+)?\\.pmtiles$"
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "file",
        "version",
        "bounds"
      ],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^places-[a-z0-9]+-\\d{8}(?:\\.\\d+)?\\.pmtiles$",
          "description": "Beside the manifest, never a path"
        },
        "version": {
          "type": "string"
        },
        "bytes": {
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "minzoom": {
          "type": "integer"
        },
        "maxzoom": {
          "type": "integer"
        },
        "bounds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[west, south, east, north]"
        },
        "license": {
          "type": "string",
          "description": "RD11: the pack's license family (a stores pack is `odbl`); absent means cc0"
        },
        "blocks": {
          "type": "object",
          "description": "PP11: a hash of the places in each z8 block; a client rebuilds an area only when its block changes",
          "propertyNames": {
            "pattern": "^8/\\d+/\\d+$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          }
        }
      }
    }
  }
}
